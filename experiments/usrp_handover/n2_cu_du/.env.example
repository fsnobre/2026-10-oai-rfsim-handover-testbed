# N2 CU/DU USRP handover (distributed) — per-deployment LAN addressing.
# Copy to .env on EACH host and fill in your real LAN IPs.

# Core host LAN IP — used as the route gateway: each RAN host routes the CN
# bridge subnet (192.168.70.128/26) via this IP. See the distributed guide
# (scripts/usrp_core_routing.sh sets up forwarding on the core host).
CORE_HOST_IP=192.168.1.10

# AMF N2 address the RAN connects to (the AMF's CN-bridge address, reachable
# from RAN hosts once the route above is in place).
AMF_N2_IP=192.168.70.132

# Site 0 (handover source): cu0 + du0.
CU0_HOST_IP=192.168.1.20
DU0_HOST_IP=192.168.1.30
DU0_SDR_ADDR=192.168.40.2

# Site 1 (handover target): cu1 + du1.
CU1_HOST_IP=192.168.1.25
DU1_HOST_IP=192.168.1.40
DU1_SDR_ADDR=192.168.40.2
