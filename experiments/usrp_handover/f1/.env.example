# F1 USRP handover (distributed) — per-deployment LAN addressing.
# Copy to .env on EACH host and fill in your real LAN IPs. Each compose file
# only uses the variables relevant to the role it starts.

# Core host LAN IP — used as the route gateway: each RAN host routes the CN
# bridge subnet (192.168.70.128/26) via this IP. See the distributed guide
# (scripts/usrp_core_routing.sh sets up forwarding on the core host).
CORE_HOST_IP=192.168.1.10

# AMF N2 address the RAN connects to. This is the AMF's address on the CN bridge
# (reachable from RAN hosts once the route above is in place). Leave as default
# unless you changed the CN subnet.
AMF_N2_IP=192.168.70.132

# CU host LAN IP (F1 listen + NG source + Telnet trigger target).
CU_HOST_IP=192.168.1.20

# DU host LAN IPs (F1 local addresses).
DU0_HOST_IP=192.168.1.30
DU1_HOST_IP=192.168.1.40

# Each DU's USRP X310 address on that host's dedicated 10GbE link.
DU0_SDR_ADDR=192.168.40.2
DU1_SDR_ADDR=192.168.40.2
